{
  "manifest_version": 3,
  "name": "DeepSeek Browser Agent",
  "version": "1.1.0",
  "description": "An agentic browser extension powered by DeepSeek AI that can see your page and complete tasks",
  "permissions": ["activeTab", "scripting", "storage", "sidePanel", "tabs", "alarms"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "src/sidebar/sidebar.html"
  },
  "action": {
    "default_title": "DeepSeek Browser Agent"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content/content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
